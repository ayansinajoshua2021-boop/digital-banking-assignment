PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/digital_banking
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1d

# Use true for local assignment testing when NibssByPhoenix credentials are unavailable.
MOCK_NIBSS=true

NIBSS_BASE_URL=https://nibssbyphoenix.onrender.com
NIBSS_API_KEY=
NIBSS_API_SECRET=
NIBSS_BANK_CODE=
NIBSS_BANK_NAME=

# Set these paths to the exact paths in the NibssByPhoenix Swagger supplied by TS Academy.
NIBSS_ONBOARD_PATH=/api/fintech/onboard
NIBSS_BVN_PATH=/api/fintech/verify-bvn
NIBSS_NIN_PATH=/api/fintech/verify-nin
NIBSS_ACCOUNT_PATH=/api/fintech/accounts
NIBSS_BALANCE_PATH=/api/fintech/accounts/{accountNumber}/balance
NIBSS_NAME_ENQUIRY_PATH=/api/fintech/name-enquiry/{accountNumber}
NIBSS_TRANSFER_PATH=/api/fintech/transfers
NIBSS_STATUS_PATH=/api/fintech/transfers/{reference}
